# ---- Database (Docker maps host port 5433 -> container 5432) ----
POSTGRES_USER=lenny_user
POSTGRES_PASSWORD=lenny_dev_password_change_in_prod
POSTGRES_DB=lenny_growth_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://lenny_user:lenny_dev_password_change_in_prod@localhost:5433/lenny_growth_db

# ---- Local model (default). Change the model here - NO code change needed ----
# Used when running the backend directly on your machine. Docker Compose ignores this and uses
# host.docker.internal (override with DOCKER_OLLAMA_BASE_URL if needed).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=180

# ---- Optional cloud model (explicit opt-in in the UI; never used silently) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Behaviour ----
LLM_PROVIDER=ollama
MIN_TERM_COVERAGE=0.8        # evidence gate: 0.0 disables, higher = stricter abstention
RETRIEVER_LIMIT=4
HISTORY_TURNS=6
ESSAY_MAX_ATTEMPTS=2
AUTO_INGEST=true             # index data/transcripts automatically when the DB is empty

# ---- Platform ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
LOG_FORMAT=json              # json | text
LOG_LEVEL=INFO
